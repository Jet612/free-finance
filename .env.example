# -----------------------------------------------------------------------------
# Dashboard runtime: local development + Vercel Production
# -----------------------------------------------------------------------------
APP_NAME=Free Finance
APP_TIMEZONE=America/New_York

# Supabase Transaction pooler URI (normally port 6543).
DATABASE_URL=

# Supabase Session pooler URI (normally port 5432). Local migrations only.
DATABASE_MIGRATION_URL=

# Server-only single-user authentication. Use a unique password and a 64-char
# random hex session secret (`openssl rand -hex 32`).
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Optional dashboard "Sync now" action. Create a fine-grained GitHub token
# limited to this repository with Actions: Read and write permission.
GITHUB_SYNC_TOKEN=
GITHUB_SYNC_REPOSITORY=owner/repository

# -----------------------------------------------------------------------------
# Supabase sync API: local Python sync + GitHub Actions only
# -----------------------------------------------------------------------------
SUPABASE_URL=

# Prefer a new `sb_secret_...` key. A legacy `service_role` key also works.
# This key bypasses Row Level Security and must never reach the browser.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Plaid: local linking/sync + GitHub Actions only
# -----------------------------------------------------------------------------
# Use `sandbox` first. Change to `production` only after Trial approval.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=

# Created by the local Plaid linking helper. Long-lived and highly sensitive.
PLAID_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Robinhood: optional
# Username/password are used only by the local linking helper. They are never
# needed by Vercel or GitHub Actions.
# -----------------------------------------------------------------------------
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=

# Created after a one-time SMS or Robinhood app approval. Treat this bearer
# session as a password. Leave empty to disable Robinhood sync.
ROBINHOOD_SESSION_B64=

# -----------------------------------------------------------------------------
# Sync behavior
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
