# -----------------------------------------------------------------------------
# Dashboard runtime: local development + Vercel Production
# -----------------------------------------------------------------------------
APP_NAME=Free Finance
APP_TIMEZONE=America/New_York

# Supabase Transaction pooler URI (normally port 6543).
DATABASE_URL=

# Supabase Session pooler URI (normally port 5432). Local migrations only.
DATABASE_MIGRATION_URL=

# Supabase Auth browser configuration. These two values are intentionally
# publishable; they identify the project but grant no privileged database access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only defense-in-depth allowlist. Copy the UUID of the one manually
# provisioned user from Supabase Authentication -> Users.
DASHBOARD_USER_ID=

# Optional dashboard "Sync now" action. Create a fine-grained GitHub token
# limited to this repository with Actions: Read and write permission.
GITHUB_SYNC_TOKEN=
GITHUB_SYNC_REPOSITORY=owner/repository

# -----------------------------------------------------------------------------
# Supabase sync API: local Python sync + GitHub Actions only
# -----------------------------------------------------------------------------
SUPABASE_URL=

# Prefer a new `sb_secret_...` key. A legacy `service_role` key also works.
# This key bypasses Row Level Security and must never reach the browser.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Plaid: local linking/sync + GitHub Actions only
# -----------------------------------------------------------------------------
# Use `sandbox` first. Change to `production` only after Trial approval.
PLAID_ENV=sandbox
# Comma-separated ISO codes for institutions your Plaid account supports.
PLAID_COUNTRY_CODES=US
PLAID_CLIENT_ID=
PLAID_SECRET=

# Created by the local Plaid linking helper. This JSON array can hold one Item
# per connected institution. Long-lived and highly sensitive.
PLAID_ACCESS_TOKENS=[]

# Backward compatibility for forks created before multi-institution support.
# Leave empty when PLAID_ACCESS_TOKENS is set.
PLAID_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Robinhood: optional
# Username/password are used only by the local linking helper. They are never
# needed by Vercel or GitHub Actions.
# -----------------------------------------------------------------------------
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=

# Created after a one-time SMS or Robinhood app approval. Treat this bearer
# session as a password. Leave empty to disable Robinhood sync.
ROBINHOOD_SESSION_B64=

# -----------------------------------------------------------------------------
# Sync behavior
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
