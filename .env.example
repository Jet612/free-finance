# Deploying with the button in the README fills in almost all of this for you.
# This file is for running locally, or for setting up Vercel by hand.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME=Free Finance
APP_TIMEZONE=America/New_York

# Your setup password. Generate one: openssl rand -base64 32
# Vercel sends it to the daily sync, the first-run screen asks for it, and bank
# connections are encrypted with a key derived from it. Changing it means
# reconnecting your banks.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Plaid
# -----------------------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
# production or sandbox. Must match the kind of secret above.
PLAID_ENV=production
# Comma-separated ISO codes for the countries your Plaid account supports.
PLAID_COUNTRY_CODES=US

# -----------------------------------------------------------------------------
# Supabase
# Vercel's Supabase integration provides these automatically, using the
# POSTGRES_URL and POSTGRES_URL_NON_POOLING names for the two database settings.
# -----------------------------------------------------------------------------
# Transaction pooler URI (normally port 6543).
DATABASE_URL=
# Session pooler URI (normally port 5432). Used only to run migrations.
DATABASE_MIGRATION_URL=

# These two are intentionally public. They identify the project but grant no
# access to your data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Creates your login on the first-run screen.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Older installs only
# -----------------------------------------------------------------------------
# The owner's Supabase user ID. New installs claim ownership on /welcome instead.
# DASHBOARD_USER_ID=

# Read once by `pnpm plaid:import`, then safe to delete.
# PLAID_ACCESS_TOKENS=[]
