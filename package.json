    "drizzle-kit": "^0.31.10",
    "eslint": "9",
    "eslint-config-next": "16.4.5",
    "server-only": "^0.0.1",
    "shadcn": "4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
