    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test \"src/lib/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
